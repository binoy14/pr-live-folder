{
  "manifest_version": 3,
  "name": "GitHub PR Live Folder",
  "version": "0.1.0",
  "description": "Keeps a collapsible tab group of your open GitHub pull requests, using your existing github.com login — Arc Live Folder style.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "alarms", "storage", "offscreen"],
  "host_permissions": ["https://github.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub PR Live Folder"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["shared.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
